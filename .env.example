# LiveKit Cloud — https://cloud.livekit.io → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Deepgram — https://console.deepgram.com → API Keys
DEEPGRAM_API_KEY=...

# ElevenLabs — https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=...

# TTS provider: "openai" (default) or "elevenlabs"
TTS_PROVIDER=openai

# OpenAI TTS voice: alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_VOICE=alloy

# ElevenLabs voice ID (only used when TTS_PROVIDER=elevenlabs)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Twilio phone numbers (for reference — used in LiveKit dispatch rules, not in code)
ZENVIQ_PHONE_NUMBER=+1XXXXXXXXXX
DENTIST_PHONE_NUMBER=+1YYYYYYYYYY
